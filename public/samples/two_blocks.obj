# 示例 OBJ：两个独立分块（o 分组），共享边位置但顶点各自独立
# 可在页面通过「载入小 OBJ」导入，切换 global / perChunk 与位数观察接缝

v -2 0 -1
v  0 0 -1
v  0 1.2 -1
v -2 1.2 -1
v -2 0  1
v  0 0  1
v  0 1.2  1
v -2 1.2  1

o left_block
f 1 2 3
f 1 3 4
f 1 5 6
f 1 6 2
f 2 6 7
f 2 7 3
f 3 7 8
f 3 8 4
f 4 8 5
f 4 5 1
f 5 8 7
f 5 7 6

v 0 0 -1
v 2 0 -1
v 2 1.2 -1
v 0 1.2 -1
v 0 0  1
v 2 0  1
v 2 1.2  1
v 0 1.2  1

o right_block
f 9  10 11
f 9  11 12
f 9  13 14
f 9  14 10
f 10 14 15
f 10 15 11
f 11 15 16
f 11 16 12
f 12 16 15
f 12 15 13
f 13 15 16
f 13 16 14
