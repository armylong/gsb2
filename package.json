{
  "name": "surface-route-annotator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在弯曲三角网格表面放置/编辑路线标注的 Three.js 小工具",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run smoke"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
