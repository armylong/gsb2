{
  "name": "rotating-walkway-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "分段转动步道迷你机关原型（TypeScript + Canvas）",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/engine.test.ts --bundle --platform=node --format=esm --outfile=dist/test.js && node --test dist/test.js",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
