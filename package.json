{
  "name": "specimen-draft-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "标本轮选规则本地试验台: 三队同步选牌、撞选裁定、备用顺延、成套计分与存档回放",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
