{
  "name": "turn-debugger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "小型回合战斗调试页: 计划 -> 预览 -> 执行 -> 回放",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
