{
  "name": "rigid-chain-testbed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "二维刚体关节链试验台：Planck.js + TypeScript + Canvas",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx scripts/e2e-smoke.ts",
    "e2e:visual": "tsx scripts/e2e-visual.ts",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "planck": "^1.5.1"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
