{
  "name": "formant-synth-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地共振峰合成元音试听台：声源混合、三段可调共振区、口形时间线、WAV 导出与回读",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
