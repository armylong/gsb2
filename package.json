{
  "name": "epicycle-trace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "手画封闭曲线 -> 带旋转方向的傅里叶圆链 -> 逐步恢复轮廓的本地 Canvas 画板",
