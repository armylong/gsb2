    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && vitest run"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "typescript": "~5.7.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
